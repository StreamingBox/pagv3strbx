# Copia a .env en el servidor o exporta estas variables antes de iniciar PM2.
# No subas valores reales al repositorio.

NODE_ENV=production
GO_ENV=production

DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PUBLIC_BASE_URL=https://strbx.com.co
FRONTEND_URL=https://strbx.com.co
# Dominios que deben usar precios/vista Lite. Los subdominios lite.*, cliente.* y clientes.* se detectan solos.
LITE_HOSTS=lite.strbx.com.co,clientes.strbx.com.co

# Token compartido solo entre gateway/proxy interno y microservicios Go.
# Genera uno nuevo con: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=
GO_SERVICE_BIND_ADDR=127.0.0.1
GATEWAY_PORT=8000
CODES_PORT=8001
STORE_PORT=8002
CODES_SERVICE_URL=http://127.0.0.1:8001
STORE_SERVICE_URL=http://127.0.0.1:8002

GMAIL_EMAIL=
GMAIL_IMAP_PASS=

# Portal externo de códigos. Solo las cuentas Netflix marcadas como Jeff Premium
# usan este flujo; las demás cuentas siguen con Gmail/STRBX.
# JEFF_PROVIDER_BASE_URL=https://proveedores-jeff.store/v1
# JEFF_PROVIDER_PLATFORM_SLUGS=netflix (compatibilidad antigua; no requerido)
# JEFF_PROVIDER_USERNAME=
# JEFF_PROVIDER_PASSWORD=
# JEFF_PROVIDER_TIMEOUT_MS=15000
# JEFF_PROVIDER_MAX_AGE_MINUTES=15
# JEFF_PROVIDER_LOGIN_PATH=/app-login
# JEFF_PROVIDER_INBOX_PATH=/user-panel/inbox
# JEFF_PROVIDER_SEARCH_PATH=
# JEFF_PROVIDER_SEARCH_FIELD=email
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
SALES_CONTACT_PHONE=3152485340

# API protegida para un segundo bot de Telegram que solo consulta agregados de stock.
# Enviar como Authorization: Bearer <token> o x-telegram-stock-token: <token>.
TELEGRAM_STOCK_API_TOKEN=

# NotiFace -> venta desde Facebook/Telegram.
# Debe coincidir con NotiFaceSalesApiToken del monitor instalado en el PC.
NOTIFACE_INTEGRATION_TOKEN=
NOTIFACE_SALES_USER_EMAIL=cuentastrbx@gmail.com

# Compra minima mensual para revendedores COP. La primera evaluacion se hace
# al terminar el mes configurado; los usuarios de otras monedas y Lite no aplican.
MONTHLY_MINIMUM_PURCHASE_COP=30000
MONTHLY_MINIMUM_START_DATE=2026-06-01

WASENDER_WEBHOOK_SECRET=
WASENDER_SKIP_SIGNATURE=false
