# Copia a .env y rellena (nunca subas .env al repositorio)

DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=

# Requerido si se despliegan los microservicios Go en produccion.
# Debe coincidir con el valor exportado para PM2/gateway.
INTERNAL_SERVICE_TOKEN=

# Pool opcional
# DB_POOL_LIMIT=2

# SMTP (opcional; si falta, Gmail puede usarse vía GMAIL_*)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Gmail (IMAP / envío)
# GMAIL_EMAIL=
# GMAIL_IMAP_PASS=

# IMAP: por defecto TLS verificado. Solo si necesitas certificados no estándar:
# IMAP_TLS_INSECURE=true

# NOWPayments
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1

# WaSender / WhatsApp
# WASENDER_WEBHOOK_SECRET=
# WASENDER_SKIP_SIGNATURE=false

# Link compartido /s/:token — JSON de credenciales (format=json)
# Por defecto solo navegadores (Sec-Fetch-Site / Referer); curl/scripts: CREDENTIAL_JSON_ALLOW_INSECURE=true
# CREDENTIAL_SHARE_JSON_STRICT=false desactiva esa comprobación (no recomendado en prod)
# CREDENTIAL_JSON_RATE_MAX=5
# CREDENTIAL_JSON_ALLOW_INSECURE=true
