# Copia a .env y rellena (nunca subas .env al repositorio)

DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=
# Keep IPv4 first for hosting providers that publish unreachable IPv6 MySQL records.
DB_DNS_RESULT_ORDER=ipv4first

# Requerido si se despliegan los microservicios Go en produccion.
# Debe coincidir con el valor exportado para PM2/gateway.
INTERNAL_SERVICE_TOKEN=

# Pool opcional
# DB_POOL_LIMIT=2

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# URLs
FRONTEND_URL=
PUBLIC_BASE_URL=

# SMTP (opcional; si falta, Gmail puede usarse via GMAIL_*)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_TLS_REJECT_UNAUTHORIZED=true
# SMTP_CONNECTION_TIMEOUT_MS=30000
# SMTP_GREETING_TIMEOUT_MS=30000
# SMTP_SOCKET_TIMEOUT_MS=60000

# Correo exclusivo de soporte
# SUPPORT_SMTP_HOST=
# SUPPORT_SMTP_PORT=587
# SUPPORT_SMTP_USER=soporte@strbx.com.co
# SUPPORT_SMTP_PASS=
# SUPPORT_SMTP_SECURE=false
# SUPPORT_SMTP_TLS_REJECT_UNAUTHORIZED=true
# SUPPORT_MAIL_FROM=Streaming Box Soporte <soporte@strbx.com.co>
# SUPPORT_INBOX=soporte@strbx.com.co
# SUPPORT_UPLOAD_DIR=/var/www/pageV3/backend/storage/support

# Gmail (IMAP / envio)
# GMAIL_EMAIL=
# GMAIL_IMAP_PASS=

# Portal externo de códigos. Solo las cuentas Netflix marcadas como Jeff Premium
# usan este flujo; las demás cuentas siguen con Gmail/STRBX.
# JEFF_PROVIDER_BASE_URL=https://proveedores-jeff.store/v1
# JEFF_PROVIDER_PLATFORM_SLUGS=netflix (compatibilidad antigua; no requerido)
# JEFF_PROVIDER_USERNAME=
# JEFF_PROVIDER_PASSWORD=
# JEFF_PROVIDER_TIMEOUT_MS=15000
# JEFF_PROVIDER_MAX_AGE_MINUTES=15
# JEFF_PROVIDER_LOGIN_PATH=/app-login
# JEFF_PROVIDER_INBOX_PATH=/user-panel/inbox
# JEFF_PROVIDER_SEARCH_PATH=
# JEFF_PROVIDER_SEARCH_FIELD=email

# StoreTools.co — códigos de inicio para cuentas Netflix marcadas como StoreTools
# Solo requiere el ID de usuario del proveedor; nunca se expone al cliente.
# STORETOOLS_PROVIDER_BASE_URL=https://storetools.co
# STORETOOLS_PROVIDER_USER_ID=
# STORETOOLS_PROVIDER_TIMEOUT_MS=15000

# LiveOnix — códigos de inicio para cuentas Netflix marcadas como LiveOnix
# LIVEONIX_PROVIDER_BASE_URL=https://liveonix.myes.space
# LIVEONIX_PROVIDER_USERNAME=
# LIVEONIX_PROVIDER_PASSWORD=
# LIVEONIX_PROVIDER_TIMEOUT_MS=15000
# LIVEONIX_PROVIDER_MAX_MESSAGES=12

# IMAP: por defecto TLS verificado. Solo si necesitas certificados no estandar:
# IMAP_TLS_INSECURE=true

# Google Drive — Publicidad
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# Si se omite, se genera desde PUBLIC_BASE_URL/FRONTEND_URL.
# GOOGLE_DRIVE_OAUTH_REDIRECT_URI=https://strbx.com.co/api/admin/advertising/drive/oauth/callback
# GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_DRIVE_PRIVATE_KEY=
# GOOGLE_DRIVE_PARENT_FOLDER_ID=
# PUBLIC_APP_URL=https://strbx.com.co

# Telegram Bot
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_IDS=
# TELEGRAM_BOT_ENABLED=true
# TELEGRAM_BOT_POLLING=true

# API protegida para un segundo bot de Telegram: solo devuelve conteos agregados.
# TELEGRAM_STOCK_API_TOKEN=

# NotiFace -> venta desde Facebook/Telegram
# Usa un token largo y secreto. NotiFace debe enviarlo como Authorization: Bearer <token>.
# NOTIFACE_INTEGRATION_TOKEN=
# NOTIFACE_SALES_USER_EMAIL=cuentastrbx@gmail.com

# WaSender / WhatsApp
# WASENDER_API_URL=
# WASENDER_API_TOKEN=
# WASENDER_WEBHOOK_SECRET=
# WASENDER_SKIP_SIGNATURE=false

# Link compartido /s/:token — JSON de credenciales (format=json)
# Por defecto solo navegadores (Sec-Fetch-Site / Referer); curl/scripts: CREDENTIAL_JSON_ALLOW_INSECURE=true
# CREDENTIAL_SHARE_JSON_STRICT=false desactiva esa comprobacion (no recomendado en prod)
# CREDENTIAL_JSON_RATE_MAX=5
# CREDENTIAL_JSON_ALLOW_INSECURE=true
